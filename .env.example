# GuruAI — Environment Configuration
# Copy to .env and fill in values.

# ── WebSocket & HTTP ports ────────────────────────────────────
PORT=8765
HTTP_PORT=3000

# ── Gnani.ai speech (Prisma STT + Timbre TTS) ─────────────────
# API key from the Gnani platform (app.gnani.ai). Server-side only — it is
# never sent to the browser. Without it the server runs but cannot hear or speak.
GNANI_API_KEY=
# Prisma STT model: prisma-v3.0 (codemix, indic-auto, keyterms) | prisma-v2.5
GNANI_STT_MODEL=prisma-v3.0
# Timbre TTS model and DEFAULT voice (students pick their own in the app).
# All 13 timbre-v3.0 voices speak all 10 languages: Shivani, Kalpana, Chetana,
# Tarika, Lakshmi, Vasudha, Riyaa (female); Yashraj, Devansh, Shubham, Avinash,
# Harshad, Prakash (male). timbre-v2.5 voices are different (one language each).
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
# 0.85 – 1.15
GNANI_TTS_SPEED=1.0
GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_URL=wss://api.vachana.ai/api/v1/tts
# REST endpoints: STT retry when a streaming utterance fails or comes back
# empty (set GNANI_STT_REST_URL= to disable), and voice-picker samples.
GNANI_STT_REST_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_REST_URL=https://api.vachana.ai/api/v1/tts/inference
# Gnani's server VAD confidence (0–1). Gnani suggests 0.45–0.55 for a clean
# headset/laptop mic, 0.65–0.75 for noisy rooms. Default 0.5.
GNANI_STT_VAD_THRESHOLD=0.5
# Voice samples are cached here after the first play.
VOICE_PREVIEW_DIR=data/voice-previews

# Vocabulary biasing — subject terms Prisma might mishear. Comma-separated,
# and/or one per line in vocab.txt. Sent as `keyterms` (v3.0) / `bias_list`
# (v2.5). ASCII terms only (HTTP header limitation).
VANI_VOCAB=
VANI_VOCAB_FILE=vocab.txt

# ── Vosk (live captions only) ─────────────────────────────────
# Prisma returns only final transcripts; Vosk shows the student's words live
# while they speak. Display-only — Prisma's text is what the LLM sees.
# One model per language: VOSK_MODEL_PATH_<EN|HI|HINGLISH|BN|GU|KN|ML|MR|PA|TA|TE>.
# Download small models from https://alphacephei.com/vosk/models and unzip
# into models/. A language with no model simply has no live captions.
# Hinglish falls back to the Hindi model, then English.
VOSK_MODEL_PATH_EN=models/vosk-model-small-en-in-0.4
VOSK_MODEL_PATH_HI=models/vosk-model-small-hi-0.22
# VOSK_MODEL_PATH_TE=models/vosk-model-small-te-0.42
# VOSK_MODEL_PATH_GU=models/vosk-model-small-gu-0.42
# Bytes of PCM handed to the recognizer at a time (4000 ≈ 125ms @16kHz).
VOSK_CHUNK_BYTES=4000

# ── Notes PDF ─────────────────────────────────────────────────
# PDFs are printed by the system Google Chrome (playwright-core, no download).
# Use another installed channel, or point at any Chromium executable.
# PDF_BROWSER_CHANNEL=chrome
# PDF_BROWSER_PATH=/usr/bin/chromium
# Where rendered notes are kept, and how long after a change to re-render.
NOTES_DIR=data/notes
PDF_DEBOUNCE_MS=5000

# ── Groq API ──────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# Background jobs (session memory, titles) can use a smaller/faster model than
# answers. Defaults to GROQ_MODEL. Answers need a strong model for the teaching
# method — if gpt-oss-20b follows it loosely, try GROQ_MODEL=openai/gpt-oss-120b.
# SUMMARY_MODEL=llama-3.1-8b-instant
# Delay before GuruAI greets a newly opened session (ms).
OPENER_DELAY_MS=400

# ── Gemini API ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_PROVIDER=gemini # "groq" or "gemini"

