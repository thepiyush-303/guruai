{
  "name": "guruai",
  "version": "0.1.0",
  "description": "GuruAI — multilingual voice study teacher (Gnani Prisma STT + Timbre TTS)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand --forceExit",
    "smoke:gnani": "ts-node src/scripts/gnaniSmoke.ts",
    "smoke:tts-long": "ts-node src/scripts/ttsLongSmoke.ts"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.5.0",
    "katex": "^0.16.47",
    "playwright-core": "^1.65.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.12",
    "@types/katex": "^0.16.8",
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
